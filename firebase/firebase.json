{
  "functions": [
    {
      "source": "functions",
      "codebase": "characters",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "test",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5417
    },
    "firestore": {
      "port": 8417
    },
    "hub": {
      "port": 4417
    },
    "logging": {
      "port": 4517
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
