        sqlitedata_icloud_userModificationTime_trackedFields     ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_weekdayMask       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_windows           ENCRYPTED INT64,
        stars                                                    ENCRYPTED INT64,
        title                                                    ENCRYPTED STRING,
        trackedFields                                            ENCRYPTED STRING,
        weekdayMask                                              ENCRYPTED INT64,
        windows                                                  ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

