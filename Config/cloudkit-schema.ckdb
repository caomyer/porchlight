DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE careLog (
        "___createTime"                                        TIMESTAMP,
        "___createdBy"                                         REFERENCE,
        "___etag"                                              STRING,
        "___modTime"                                           TIMESTAMP,
        "___modifiedBy"                                        REFERENCE,
        "___recordID"                                          REFERENCE,
        careRoutineId                                          ENCRYPTED STRING,
        createdAt                                              ENCRYPTED TIMESTAMP,
        deviceId                                               ENCRYPTED STRING,
        durationMinutes                                        ENCRYPTED INT64,
        id                                                     ENCRYPTED STRING,
        note                                                   ENCRYPTED STRING,
        occurredAt                                             ENCRYPTED TIMESTAMP,
        pee                                                    ENCRYPTED INT64,
        poo                                                    ENCRYPTED INT64,
        slot                                                   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime                 ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_careRoutineId   ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_createdAt       ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deviceId        ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_durationMinutes ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id              ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_note            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_occurredAt      ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_pee             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_poo             ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_slot            ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_stars           ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_vibe            ENCRYPTED INT64,
        stars                                                  ENCRYPTED INT64,
        vibe                                                   ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE careLogPerson (
        "___createTime"                                  TIMESTAMP,
        "___createdBy"                                   REFERENCE,
        "___etag"                                        STRING,
        "___modTime"                                     TIMESTAMP,
        "___modifiedBy"                                  REFERENCE,
        "___recordID"                                    REFERENCE,
