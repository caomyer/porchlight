# Copy to Config/AppStoreConnect.env (git-ignored) and fill in your App Store Connect API
# key, from App Store Connect › Users and Access › Integrations › App Store Connect API.
# The scripts that sign (deploy-ipad.sh, testflight.sh) use it so xcodebuild can refresh
# profiles from the command line. Keep the .p8 file outside the repository.
PORCHLIGHT_ASC_KEY_PATH=~/.appstoreconnect/AuthKey_ABC123DEF4.p8
PORCHLIGHT_ASC_KEY_ID=ABC123DEF4
PORCHLIGHT_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
